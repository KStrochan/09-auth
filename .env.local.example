# Локально:
NEXT_PUBLIC_API_URL=http://localhost:3000

# Після деплою на Vercel замініть на URL свого застосунку, наприклад:
# NEXT_PUBLIC_API_URL=https://your-app-name.vercel.app

# NEXT_PUBLIC_NOTEHUB_TOKEN більше не потрібен — новий бекенд
# (notehub-api.goit.study) використовує авторизацію через httpOnly-куки,
# а не статичний токен.
